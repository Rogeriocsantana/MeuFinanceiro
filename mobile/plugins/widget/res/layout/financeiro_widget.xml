<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
 android:gravity="top">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
  android:paddingStart="17dp" android:paddingEnd="17dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/financeiro_widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
  <ImageView android:layout_width="25dp" android:layout_height="25dp" android:layout_marginEnd="8dp" android:src="@mipmap/ic_launcher_round" android:importantForAccessibility="no"/>
  <TextView android:id="@+id/widget_brand" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="Financeiro" android:textStyle="bold" android:textColor="#A9C3FF" android:textSize="14sp"/>
  <ImageButton android:id="@+id/widget_eye" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:scaleType="fitCenter" android:background="@android:color/transparent" android:src="@drawable/financeiro_widget_eye_off" android:contentDescription="Mostrar valores"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saldo em contas" android:textColor="#F1F4FF" android:textStyle="bold" android:textSize="17sp"/>
 <TextView android:id="@+id/widget_period" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BCC7DE" android:textSize="12sp"/>
 <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:measureAllChildren="true">
  <LinearLayout android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:id="@+id/widget_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="••••" android:textSize="30sp" android:textStyle="bold" android:textColor="#F1F4FF" android:maxLines="1"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:layout_marginBottom="6dp" android:text="Ainda está previsto" android:textColor="#A9C3FF" android:textSize="12sp" android:textStyle="bold"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/financeiro_widget_selected" android:padding="12dp" android:layout_marginEnd="6dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A pagar" android:textColor="#BCC7DE" android:textSize="12sp"/>
    <TextView android:id="@+id/widget_pay" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#F1F4FF" android:textStyle="bold" android:textSize="17sp"/>
   </LinearLayout>
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/financeiro_widget_selected" android:padding="12dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A receber" android:textColor="#BCC7DE" android:textSize="12sp"/>
    <TextView android:id="@+id/widget_receive" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#91DFB8" android:textStyle="bold" android:textSize="17sp"/>
   </LinearLayout>
   </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_agenda" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="5dp" android:visibility="gone"/>
 </FrameLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:gravity="center">
  <ImageButton android:id="@+id/widget_summary_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:scaleType="center" android:src="@drawable/financeiro_widget_summary" android:background="@android:color/transparent" android:contentDescription="Resumo"/>
  <ImageButton android:id="@+id/widget_agenda_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:scaleType="center" android:src="@drawable/financeiro_widget_agenda" android:background="@android:color/transparent" android:contentDescription="Agenda"/>
 </LinearLayout>
 </LinearLayout>
</LinearLayout>
