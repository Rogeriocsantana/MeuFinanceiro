<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView android:id="@+id/widget_row_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#F1F4FF" android:textSize="15sp"/>
  <TextView android:id="@+id/widget_row_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BCC7DE" android:textSize="12sp"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_row_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#F1F4FF" android:textStyle="bold" android:textSize="15sp"/>
 </LinearLayout>
 <TextView android:importantForAccessibility="no" android:layout_width="match_parent" android:layout_height="1dp" android:background="#424859"/>
</LinearLayout>
